// RUN: sh -c '%compiler %s --output %t 2>&1 | /opt/homebrew/opt/llvm/bin/FileCheck %s -DPATH=%s'

struct String {}

fn main() {
  // Do not assign to literal numbers
  123 = 456;
  // Do not assign to literal strings
  "Hello" = "World";
  // Do not assign to struct Symbols
  String = 456;
  // Do not assign to function Symbols
  main = 456;
}

// CHECK: Error: [[PATH]]:7:3:
// CHECK-NEXT: 123 = 456;
// CHECK-NEXT: ^ can not assign to temporary (R-Value)

// CHECK: Error: [[PATH]]:9:3:
// CHECK-NEXT: "Hello" = "World";
// CHECK-NEXT: ^ can not assign to temporary (R-Value)

// CHECK: Error: [[PATH]]:11:3:
// CHECK-NEXT: String = 456;
// CHECK-NEXT: ^ expected value, but found 'String'

// CHECK: Error: [[PATH]]:13:3:
// CHECK-NEXT: main = 456;
// CHECK-NEXT: ^ can not assign to 'main'