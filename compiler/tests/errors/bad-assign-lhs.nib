// RUN: %compiler %s --disable-logging 2> %t.err || true
// RUN: sed "s|%s|[[PATH]]|g" %t.err | diff -u %s.out -

struct String {}

fn main() {
  // Do not assign to literal numbers
  123 = 456;
  // Do not assign to literal strings
  "Hello" = "World";
  // Do not assign to struct Symbols
  String = 456;
  // Do not assign to function Symbols
  main = 456;
}
