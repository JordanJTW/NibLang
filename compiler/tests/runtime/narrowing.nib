fn test_logical_and() -> i32 {
  let a: String? = GetWord();
  let b: String? = GetWord();

  // Both must be non-nil for the body to execute
  if (a != Nil && b != Nil) {
    let s1: String = a;
    let s2: String = b;
    return a.length()+ s2.length();
  }
  return 0;
}
