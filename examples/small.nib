extern struct Promise[T] {
  static fn new[T]() -> Promise[T];

    static fn all[ResultType](
      promises: Array[Promise[ResultType]]
    ) -> Promise[Array[ResultType]] {
      let promise = Promise.new();
        return promise;
      }
}

