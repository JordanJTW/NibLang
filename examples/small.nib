struct Box[T] {
  value: T?;

  static fn new[T]() -> Box[T] {
    return Box(Nil);
  }
}

struct MapNode[Key, Value] {
    key: Key;
    value: Value;
    next: MapNode[Key, Value]?;
}

struct HashMap[Key, Value] {
    buckets: Array[MapNode[Key, Value]?];
//     equalsFn: fn (Key, Key) -> bool;
//     hashFn: fn (Key) -> i32;

    static fn new[NewKey, NewValue](
//         equalsFn: fn (Key, Key) -> bool,
//         hashFn: fn (Key) -> i32,
    ) -> HashMap[NewKey, NewValue] {
        return HashMap(Array.withSize(13));//, equalsFn, hashFn);
    }
}

