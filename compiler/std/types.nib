@import "std/operators.nib"

interface Hashable {
  fn hash() -> i32;
}

extern struct Array[T] {
  static fn new[F]() -> Array[F];
  static fn init[F](...F) -> Array[F];
  static fn withSize[F](size: i32) -> Array[F];

  fn push(value: T);
  fn get(idx: i32) -> T;
  fn set(idx: i32, value: T);
  fn length() -> i32;

  fn slice(start: i32, count: i32) -> Array[T] {
    let slice: Array[T] = Array.withSize(count);

    let idx = 0;
    while (start + idx < self.length() && idx < count) {
      slice.set(idx, self.get(start + idx));
      idx = idx + 1;
    }
    return slice;
  }

  fn map[N](transform: fn(T) -> N) -> Array[N] {
    let result: Array[N] = Array.withSize(self.length());

    let idx = 0;
    while (idx < self.length()) {
      result.set(idx, transform(self.get(idx)));
      idx = idx + 1;
    }

    return result;
  }
}

struct Box[T] {
  value: T;
}

extern struct Map[K, V] {
  static fn new[K, V]() -> Map[K, V];
  fn get(key: K) -> V;
  fn set(key: K, value: V);
}

extern struct Promise[T] {
  static fn new[T]() -> Promise[T];

  fn fulfill(value: T);
  fn reject(error: any);
  fn then[R1 = T, R2 = never](
      on_fulfill: (fn(T)->R1)?,
      on_reject: (fn(any)->R2)?
  ) -> Promise[R1|R2];

  static fn all[ResultType](
    promises: Array[Promise[ResultType]]
  ) -> Promise[Array[ResultType]] {
    let promise: Promise[Array[ResultType]] = Promise.new();

    let results: Array[ResultType] = Array.withSize(promises.length());
    let completed = Box(0);

    let idx = 0;
    while (idx < promises.length()) {
      promises.get(idx).then(
        fn (value: ResultType) {
          results.set(idx, value);
          completed.value = completed.value + 1;

          if (completed.value == promises.length()) {
            promise.fulfill(results);
          }
        },
        fn (error: any) -> any {
          if (completed.value != -1) {
            promise.reject(error);
            completed.value = -1;
          }
          return Nil;
        }
      );
      idx = idx + 1;
    }
    return promise;
  }
}

extern struct String {
  static fn valueOf(value: any) -> String;
  fn length() -> i32;
  fn charAt(idx: i32) -> Codepoint;
  fn substr(start: i32, end: i32) -> String;
  fn startsWith(prefix: String, idx: i32) -> bool;

  static fn hash(value: String) -> i32;
  static fn equals(v1: String, v2: String) -> bool;

  implements Hashable {
    fn hash() -> i32 {
      return String.hash(self);
    }
  }
  implements EqualTo {
    fn equalTo(o: String) -> bool {
      return String.equals(self, o);
    }
  }
  implements CompareTo {
    fn compareTo(o: String) -> i32;
  }
  implements Add {
    fn add(o: String) -> String;
  }
}

extern struct bool {
  implements Hashable {
    fn hash() -> i32 {
      if (self) { return 1231; } else { return 1237; }
    }
  }
  implements EqualTo {
    fn equalTo(o: bool) -> bool {
      return self.hash() == o.hash();
    }
  }
}

extern struct i32 {
  implements Hashable {
    fn hash() -> i32 { return self; }
  }
  implements EqualTo {
    fn equalTo(o: i32) -> bool;
  }
  implements CompareTo {
    fn compareTo(o: i32) -> i32;
  }
  implements Add {
    fn add(o: i32) -> i32;
  }
  implements Subtract {
    fn subtract(o: i32) -> i32;
  }
  implements Multiply {
    fn multiply(o: i32) -> i32;
  }
  implements Divide {
    fn divide(o: i32) -> i32;
  }
  implements Modulus {
    fn mod(o: i32) -> i32;
  }
  implements Bitwise {
    fn and(o: i32) -> i32;
    fn xor(o: i32) -> i32;
  }
}

extern struct f32 {
  implements EqualTo {
    fn equalTo(o: f32) -> bool;
  }
  implements CompareTo {
    fn compareTo(o: f32) -> i32;
  }
  implements Add {
    fn add(o: f32) -> f32;
  }
  implements Subtract {
    fn subtract(o: f32) -> f32;
  }
  implements Multiply {
    fn multiply(o: f32) -> f32;
  }
  implements Divide {
    fn divide(o: f32) -> f32;
  }
}

extern struct Codepoint {
  implements EqualTo {
    fn equalTo(o: Codepoint) -> bool {
      return self as i32 == o as i32;
     }
  }
  implements CompareTo {
    fn compareTo(o: Codepoint) -> i32 {
      return self as i32 - o as i32;
    }
  }
}
